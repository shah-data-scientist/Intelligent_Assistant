{
  "version": "3.0",
  "created_at": "2026-01-26",
  "description": "Conversational evaluation dataset for RAG-based Cultural Events Chatbot - Emphasis on multi-turn dialogues, context retention, and clarifying questions",
  "schema_notes": {
    "conversations": "Multi-turn test scenarios grouped by session_id. Each turn builds on previous context.",
    "single_queries": "Standalone queries for testing specific functionality (reduced from v2.0)",
    "turn_types": {
      "initial": "First query in a conversation - establishes context",
      "refinement": "User modifies previous request (e.g., 'actually, make that February')",
      "follow_up": "User asks about specific results (e.g., 'tell me more about the first one')",
      "topic_shift": "User changes to entirely new topic within same session",
      "clarification_response": "User responds to chatbot's clarifying question"
    }
  },
  "conversations": [
    {
      "session_id": "conv_001",
      "description": "Simple refinement: User narrows down date after initial broad query",
      "test_focus": ["context_retention", "incremental_modification"],
      "language": "fr",
      "turns": [
        {
          "turn_id": "conv_001_t1",
          "turn_number": 1,
          "turn_type": "initial",
          "query": "Concerts de jazz à Paris",
          "expected_behavior": {
            "should_ask_clarification": true,
            "clarification_topics": ["date", "month"],
            "acceptable_actions": ["ask_clarification", "show_results_with_suggestion"],
            "reason": "Query missing date - chatbot should ask when or suggest upcoming options"
          },
          "expected_filters": {
            "city": "Paris",
            "category": "Musique"
          },
          "generation_expectations": {
            "must_contain_keywords": ["jazz", "Paris"],
            "must_not_hallucinate": true,
            "expected_language": "fr"
          }
        },
        {
          "turn_id": "conv_001_t2",
          "turn_number": 2,
          "turn_type": "refinement",
          "query": "En février plutôt",
          "previous_turn": "conv_001_t1",
          "context_dependency": "Must understand 'février' applies to the previous jazz/Paris query",
          "expected_behavior": {
            "should_use_context": true,
            "inherited_filters": ["city", "category"],
            "new_filters": {"month": 2}
          },
          "expected_filters": {
            "city": "Paris",
            "category": "Musique",
            "month": 2
          },
          "generation_expectations": {
            "must_contain_keywords": ["jazz", "Paris", "février"],
            "must_not_hallucinate": true,
            "expected_language": "fr"
          }
        },
        {
          "turn_id": "conv_001_t3",
          "turn_number": 3,
          "turn_type": "follow_up",
          "query": "Parle-moi du premier",
          "previous_turn": "conv_001_t2",
          "context_dependency": "Must reference the first event from previous turn's results",
          "expected_behavior": {
            "should_use_context": true,
            "references_previous_results": true,
            "expected_action": "provide_details_on_first_result"
          },
          "generation_expectations": {
            "must_not_hallucinate": true,
            "must_reference_specific_event": true,
            "expected_language": "fr"
          }
        }
      ]
    },
    {
      "session_id": "conv_002",
      "description": "Topic shift: User starts with jazz, shifts to theater completely",
      "test_focus": ["context_retention", "topic_shift_detection"],
      "language": "en",
      "turns": [
        {
          "turn_id": "conv_002_t1",
          "turn_number": 1,
          "turn_type": "initial",
          "query": "Jazz concerts in Paris this weekend",
          "expected_behavior": {
            "should_ask_clarification": false
          },
          "expected_filters": {
            "city": "Paris",
            "category": "Musique"
          },
          "generation_expectations": {
            "must_contain_keywords": ["jazz", "Paris", "weekend"],
            "must_not_hallucinate": true,
            "expected_language": "en"
          }
        },
        {
          "turn_id": "conv_002_t2",
          "turn_number": 2,
          "turn_type": "topic_shift",
          "query": "Actually, what about theater shows in Versailles?",
          "previous_turn": "conv_002_t1",
          "context_dependency": "Must recognize this is a NEW search, not a modification",
          "expected_behavior": {
            "should_use_context": false,
            "should_reset_filters": true,
            "reason": "Completely different topic (theater vs jazz, Versailles vs Paris)"
          },
          "expected_filters": {
            "city": "Versailles",
            "category": "Théâtre"
          },
          "generation_expectations": {
            "must_contain_keywords": ["theater", "Versailles"],
            "must_not_contain_keywords": ["jazz", "Paris"],
            "must_not_hallucinate": true,
            "expected_language": "en"
          }
        }
      ]
    },
