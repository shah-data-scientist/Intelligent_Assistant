  "evaluation_guidelines": {
    "context_retention_scoring": {
      "description": "How to score context retention in multi-turn conversations",
      "criteria": {
        "perfect": "All relevant context from previous turns is correctly used",
        "partial": "Some context is retained but key details are missed",
        "failed": "Context is ignored or incorrectly applied"
      }
    },
    "clarifying_question_scoring": {
      "description": "How to score clarifying question behavior",
      "criteria": {
        "appropriate": "Asks relevant clarifying questions when query is ambiguous",
        "over_clarifying": "Asks for clarification when not needed",
        "under_clarifying": "Fails to ask when query is clearly ambiguous"
      }
    },
    "topic_shift_scoring": {
      "description": "How to score topic shift detection",
      "criteria": {
        "correct": "Correctly identifies when user shifts to new topic vs refines previous",
        "false_positive": "Treats refinement as new topic (loses context unnecessarily)",
        "false_negative": "Treats new topic as refinement (applies irrelevant context)"
      }
    }
  }
}
