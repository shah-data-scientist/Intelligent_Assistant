# =============================================================================
# Intelligent Cultural Assistant - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =============================================================================
# REQUIRED - Mistral API
# =============================================================================
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# =============================================================================
# API Security
# =============================================================================
# Change this to a strong random key in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=dev-secret-key

# =============================================================================
# Database Configuration (Defaults work for Docker)
# =============================================================================
DB_PATH=./data/events.db
CHAT_DB_PATH=./data/chat_history.db
FAISS_INDEX_PATH=./data/faiss_index

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# Application Settings
# =============================================================================
LOG_LEVEL=INFO
MAX_EVENTS_TO_FETCH=20000
RETRIEVAL_TOP_K=10

# =============================================================================
# OpenAgenda API Configuration (Optional - uses public endpoint by default)
# =============================================================================
OPENAGENDA_BASE_URL=https://public.opendatasoft.com/api/explore/v2.1/catalog/datasets/evenements-publics-openagenda/records

# =============================================================================
# Vector Store Configuration
# =============================================================================
VECTOR_DIMENSION=1024

# =============================================================================
# Data Ingestion Configuration
# =============================================================================
MIN_EVENTS_REQUIRED=1000
INITIAL_TIME_WINDOW_MONTHS=12
MAX_TIME_WINDOW_MONTHS=36

# =============================================================================
# Evaluation Settings (Optional - for running metrics evaluation)
# =============================================================================
GOLDEN_DATASET_PATH=./data/evaluation/golden_dataset.json
EVALUATION_LLM_TEMPERATURE=0.0
EVALUATION_CACHE_ENABLED=true
EVALUATION_LATENCY_SLA_MS=2000.0
EVALUATION_QUALITY_SLA=0.8

# Evaluation LLM Backend Options: "mistral" (paid), "huggingface" (free tier), "ollama" (local)
EVALUATION_LLM_BACKEND=mistral

# Hugging Face Settings (if using huggingface backend)
EVALUATION_HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2
EVALUATION_HF_TOKEN=your_hf_token_here

# Ollama Settings (if using ollama backend)
EVALUATION_OLLAMA_MODEL=mistral
EVALUATION_OLLAMA_URL=http://localhost:11434
